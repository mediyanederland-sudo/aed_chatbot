# Copy to .env and supply credentials through your deployment secret store.
# No production credentials are included in this template.

# Shared vector database and embedding provider
QDRANT_URL=https://your-qdrant-host.example
QDRANT_API_KEY=
OPENAI_API_KEY=

# Response/query provider. Keep model IDs consistent with LLM_PROVIDER.
# Model names mirror the existing configuration; supply provider credentials separately.
LLM_PROVIDER=gemini
LLM_MODEL_QUERY=gemini-2.5-flash-lite
LLM_MODEL_CHAT=gemini-2.5-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL_GEMINI_FALLBACK=gemini-2.5-flash-lite
LLM_MODEL_GROQ_FALLBACK=llama-3.3-70b-versatile
GEMINI_THINKING_BUDGET=-1
GEMINI_THINKING_LEVEL=

# AED Leader: legacy environment names are intentionally retained.
WOOCOMMERCE_URL=https://www.aedleader.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Response Ready
WC_URL_RESPONSEREADY=https://responseready.com
WC_CONSUMER_KEY_RESPONSEREADY=
WC_CONSUMER_SECRET_RESPONSEREADY=

# CPR1
WC_URL_CPR1=https://cpr1.com
WC_CONSUMER_KEY_CPR1=
WC_CONSUMER_SECRET_CPR1=

# MDSI
WC_URL_MDSIMEDICAL=https://mdsimedical.com
WC_CONSUMER_KEY_MDSIMEDICAL=
WC_CONSUMER_SECRET_MDSIMEDICAL=

# AED Total Solution
WC_URL_AEDTOTALSOLUTION=https://www.aedtotalsolution.com
WC_CONSUMER_KEY_AEDTOTALSOLUTION=
WC_CONSUMER_SECRET_AEDTOTALSOLUTION=

# Admin access is disabled until credentials are configured.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN=

# A nonempty allowlist enables Origin enforcement; tenant origins are also included.
ALLOWED_ORIGINS=https://www.aedleader.com,https://responseready.com,https://cpr1.com,https://mdsimedical.com,https://www.aedtotalsolution.com
HOST_BIND_IP=127.0.0.1
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
SESSION_MSG_CAP=100

# Session storage includes contact information. Set retention to your operating policy.
MAX_LIVE_SESSIONS=500
RESUME_WINDOW_DAYS=7
MAX_SESSION_FILES=500
SESSION_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=30
CATALOG_FACTS_TTL=600
LEAD_ASK_REPLACES_QUESTION=1

# AED Leader conversion polling requires WooCommerce order-read permission.
CONVERSIONS_POLL_ENABLED=false
ORDERS_POLL_INTERVAL=1440
CONVERSIONS_FIRST_RUN_LOOKBACK_DAYS=30

# Optional external knowledge ZIP, supplied separately. CLI --archive overrides this.
KNOWLEDGE_ARCHIVE_PATH=
